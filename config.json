{
  "model": {
    "n_embd": 192,
    "n_head": 4,
    "n_layer": 6,
    "block_size": 192,
    "dropout": 0.15
  },
  "training": {
    "batch_size": 32,
    "learning_rate": 0.0003,
    "max_iters": 18000,
    "eval_interval": 500,
    "eval_iters": 50,
    "checkpoint_interval": 1000,
    "grad_clip": 1.0,
    "device": "auto"
  },
  "data": {
    "train_file": "data/training.txt",
    "val_split": 0.1
  },
  "paths": {
    "checkpoint_dir": "checkpoints",
    "tokenizer_file": "checkpoints/vocab.json"
  },
  "generation": {
    "max_new_tokens": 300,
    "temperature": 0.8,
    "top_k": 40
  }
}
